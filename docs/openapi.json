          "default": {
            "description": "Erro de validação, autorização, conflito ou indisponibilidade",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
