      }
    },
    "/keys/resolve": {
      "post": {
        "summary": "Identificar QR ou código e sugerir a próxima operação",
        "responses": {
          "200": {
            "description": "Operação concluída",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key_id": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "rooms": {
                      "type": "string"
                    },
                    "hook": {
                      "type": "string"
                    },
                    "person": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string"
                    },
                    "loan_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Erro de validação, autorização, conflito ou indisponibilidade",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "identifier recebe o texto fv:<token opaco> do QR ou o código textual. person é usado na retirada assistida. A leitura não altera a custódia.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "identifier": {
                    "type": "string"
                  },
                  "person": {
                    "type": "string"
                  }
                },
                "required": [
                  "identifier"
                ]
              }
            }
          }
        }
      }
    },
    "/loans/confirm": {
      "post": {
        "summary": "Confirmar retirada ou devolução atômica",
        "responses": {
          "200": {
            "description": "Operação concluída",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "rooms": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Erro de validação, autorização, conflito ou indisponibilidade",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "O servidor revalida a etiqueta, o estado e o contexto. Devolução exige o loan_id exibido. A operação assistida exige reason. Em retirada, forneça schedule ou purpose.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "identifier": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "person": {
                    "type": "string"
                  },
                  "loan_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "declared": {
                    "type": "string"
                  },
                  "purpose": {
                    "type": "string"
                  },
                  "schedule": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "checkout",
                      "return"
                    ]
                  },
                  "origin": {
                    "type": "string",
                    "enum": [
                      "assisted",
                      "contingency"
                    ],
                    "description": "Em contingência, exige horário físico declarado e ator operacional."
                  }
                },
                "required": [
                  "identifier",
                  "action",
                  "version"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
